# VAYU ORBIT — Production Frontend Environment Variables Example
# Duplicate this file to .env.production or configure these variables in your hosting provider (Vercel, Cloudflare Pages, etc.)

# Target Backend API URL (HTTPS required for production deployments)
# Example for Render: https://vayu-orbit-api.onrender.com
# Example for Railway: https://vayu-orbit-backend.up.railway.app
# If frontend and backend share the same domain (via reverse proxy), leave empty or set to /
VITE_API_BASE=https://vayu-orbit-backend.onrender.com

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=YOUR_PRODUCTION_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=1:YOUR_PROJECT_NUMBER:web:YOUR_APP_HASH
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check Attestation (Production reCAPTCHA Enterprise / v3 site key)
VITE_FIREBASE_RECAPTCHA_KEY=YOUR_PRODUCTION_RECAPTCHA_KEY

# TomTom Map SDK API Key (Optional)
# If omitted or left empty, the application automatically engages its offline tactical vector map canvas
VITE_TOMTOM_API_KEY=YOUR_PRODUCTION_TOMTOM_KEY_HERE
