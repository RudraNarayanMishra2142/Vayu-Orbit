# VAYU ORBIT — Frontend Environment Configuration Template
# Copy this file to .env.local or .env for local development

# Base URL for backend API requests
VITE_API_BASE=http://localhost:8000

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=1:YOUR_PROJECT_NUMBER:web:YOUR_APP_HASH
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check Attestation (Optional in local dev; required in production enforced mode)
VITE_FIREBASE_RECAPTCHA_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# TomTom Maps SDK API Key (Optional)
# If omitted or empty, the application automatically engages its offline tactical vector canvas.
# To obtain a free development API key, register at: https://developer.tomtom.com/
VITE_TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY_HERE
