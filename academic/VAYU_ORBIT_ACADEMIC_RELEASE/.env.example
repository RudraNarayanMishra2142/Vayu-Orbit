# ==============================================================================
# VAYU ORBIT v6.0.0 — Unified Environment Configuration Template
# Academic Release Problem Statement: PDS-3
# Copy this template to .env or use the component-specific examples:
#   - Frontend: frontend/.env.example / frontend/.env.production.example
#   - Backend:  backend/.env.production.example
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (React 18 + Vite)
# ------------------------------------------------------------------------------

# Base URL for backend API requests.
# Local Development: http://localhost:8000
# Production Cloud Run: https://vayu-orbit-backend-<hash>.a.run.app
VITE_API_BASE=http://localhost:8000

# Firebase Web App Configuration (vayuorbit-b20b5)
# Public client configuration for Firebase Authentication & App Check.
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderClientKeyForAcademicEvaluation
VITE_FIREBASE_AUTH_DOMAIN=vayuorbit-b20b5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vayuorbit-b20b5
VITE_FIREBASE_STORAGE_BUCKET=vayuorbit-b20b5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=914779488934
VITE_FIREBASE_APP_ID=1:914779488934:web:d5affde7412aa559a5aa67

# Firebase App Check Attestation (Optional in Local Dev / Required in Production Enforced Mode)
# Google reCAPTCHA v3 / Enterprise site key registered for App Check.
VITE_FIREBASE_APP_CHECK_KEY=

# TomTom Maps SDK API Key (Optional)
# If omitted or empty, the application automatically engages its offline tactical vector canvas.
VITE_TOMTOM_API_KEY=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI + Python 3.11)
# ------------------------------------------------------------------------------

# Application Environment: 'development', 'test', or 'production'
# In production, strict CORS, HTTPS enforcement, and disabled dev routes are activated.
APP_ENV=development

# Server Port
PORT=8000

# Database Provider: 'sqlite' (local default) or 'postgresql' (Cloud SQL / Firebase SQL Connect)
DATABASE_PROVIDER=sqlite

# SQLite Database File Path (used when DATABASE_PROVIDER=sqlite)
CMS_DB_PATH=military_logistics.db

# PostgreSQL / Cloud SQL Configuration (used when DATABASE_PROVIDER=postgresql)
# Connection string format for local testing or external PostgreSQL
# DATABASE_URL=postgresql://vayu_app_user:SecurePassword@localhost:5432/vayu_orbit_db
# Cloud SQL Instance Configuration for Cloud Run Workload Identity:
# INSTANCE_CONNECTION_NAME=vayuorbit-b20b5:asia-south1:vayu-orbit-sql
# DB_NAME=vayu_orbit_db
# DB_USER=vayu_app_user
# DB_PASSWORD=PLACEHOLDER_SET_IN_SECRET_MANAGER

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list of origins permitted to communicate with this backend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://vayuorbit-b20b5.web.app,https://vayuorbit-b20b5.firebaseapp.com

# Firebase Project ID for Admin SDK Token Verification
FIREBASE_PROJECT_ID=vayuorbit-b20b5

# Firebase App Check Verification Mode: 'disabled', 'audit', or 'enforced'
# 'disabled': Zero network calls to Google (Air-gapped / Local Development)
# 'audit': Verifies tokens and logs discrepancies without blocking traffic (Staging / Calibration)
# 'enforced': Returns 401 Unauthorized for requests lacking genuine client attestation (Production)
FIREBASE_APP_CHECK_MODE=disabled

# Legacy JWT Acceptance Gate: 'true' or 'false'
# Set to 'false' in production. Only set to 'true' during transitional multi-stage migrations.
VAYU_ALLOW_LEGACY_JWT=false

# Legacy Fallback JWT HMAC Signing Secret (64-character random hex string)
# Command to generate: python -c "import secrets; print(secrets.token_hex(32))"
VAYU_JWT_SECRET=PLACEHOLDER_CHANGE_IN_PRODUCTION_64_CHAR_HEX_STRING

# Google Cloud Service Account Credentials Path (Optional)
# Not needed on Google Cloud Run when using default Application Default Credentials (ADC).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
