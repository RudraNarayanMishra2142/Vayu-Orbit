# VAYU ORBIT — Production Backend Environment Configuration
# Copy this template to .env.production or set these environment variables in your cloud dashboard (Render, Railway, Fly.io)

# Runtime Environment (Enforces strict production CORS and hides dev fallbacks)
APP_ENV=production

# Runtime Server Port (Automatically injected by cloud providers like Render/Railway)
PORT=8000

# Explicit Allowed CORS Origins (Comma-separated HTTPS origins of your deployed frontend)
# DO NOT USE WILDCARD (*) WITH CREDENTIALS
CORS_ORIGINS=https://vayu-orbit.vercel.app,https://vayu-orbit.pages.dev

# Persistent Database File Path (Mounted persistent POSIX volume path)
# SQLite requires single-worker / single-instance (replicas: 1) execution
CMS_DB_PATH=/data/military_logistics.db

# Cryptographically Secure JWT Secret Key (Generate a random 64-character hex string)
# Command to generate: python -c "import secrets; print(secrets.token_hex(32))"
VAYU_JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHAR_RANDOM_SECRET_KEY

# Initial Password for Demonstration Evaluation Accounts (Optional)
# If provided, sets password for coordinator@vayu.local, creator@vayu.local, checkpoint@vayu.local
INITIAL_DEMO_PASSWORD=SET_A_SECURE_EVALUATION_PASSWORD_HERE
